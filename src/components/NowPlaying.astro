---
// A silent "now playing" card for the footer: it rotates through the playlist and never makes sound.
// The play/pause button also stops every moving part (WCAG 2.2.2).
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { playlist, type Lang } from "../data/profile";
import { ui } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>("../assets/covers/*.jpg", { eager: true });
const art = (file: string) => covers[`../assets/covers/${file}`].default;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
const first = playlist[0];
// covers are optimised at build time, but only the current one is in the page; the rest load when their song comes up
const tracks = await Promise.all(playlist.map(async ({ title, artist, album, duration, art: file }) => {
  const img = await getImage({ src: art(file), width: 112, height: 112, densities: [1, 2], format: "webp", quality: 80 });
  return { title, artist, album, duration, src: img.src, srcset: img.srcSet.attribute };
}));
---
<div class="np mono" data-np data-tracks={JSON.stringify(tracks)} data-label-play={ui.play[lang]} data-label-pause={ui.pause[lang]}>
  <div class="covers">
    <img class="cover" data-cover src={tracks[0].src} srcset={tracks[0].srcset} loading="lazy" alt={tracks[0].album} width="112" height="112" decoding="async" />
  </div>
  <div class="meta">
    <p class="kicker"><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>{ui.nowPlaying[lang]}<span class="bias"> · {ui.bias[lang]}</span><span class="count" aria-hidden="true"><span data-index>1</span>/{playlist.length}</span></p>
    <p class="track"><span class="title" data-title>{first.title}</span> — <span data-artist>{first.artist}</span></p>
    <div class="bar" aria-hidden="true"><span class="fill"></span></div>
    <p class="time" aria-hidden="true"><span data-elapsed>0:00</span><span data-duration>{fmt(first.duration)}</span></p>
  </div>
  <div class="controls">
    <button type="button" class="btn" data-toggle aria-label={ui.pause[lang]}><svg class="i-pause" viewBox="0 0 10 10" aria-hidden="true"><rect x="2" y="1.5" width="2" height="7" /><rect x="6" y="1.5" width="2" height="7" /></svg><svg class="i-play" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1.5 8.5 5 2.5 8.5Z" /></svg></button>
    <button type="button" class="btn" data-next aria-label={ui.next[lang]}><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 1.5 6.5 5 1.5 8.5Z" /><rect x="7" y="1.5" width="1.6" height="7" /></svg></button>
  </div>
</div>

<script>
  type Track = { title: string; artist: string; album: string; duration: number; src: string; srcset: string };
  document.querySelectorAll<HTMLElement>("[data-np]").forEach((el) => {
    const tracks: Track[] = JSON.parse(el.dataset.tracks!);
    const $ = <E extends HTMLElement>(s: string) => el.querySelector<E>(s)!;
    const cover = $<HTMLImageElement>("[data-cover]");
    const toggle = $<HTMLButtonElement>("[data-toggle]");
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    let i = 0;
    let t = Math.floor(Math.random() * tracks[0].duration * 0.6); // join the first song somewhere in the middle
    let timer: number | undefined;

    const render = () => {
      $("[data-elapsed]").textContent = fmt(t);
      el.style.setProperty("--p", String(t / tracks[i].duration));
    };
    const load = (n: number) => {
      i = n % tracks.length; t = 0;
      const k = tracks[i];
      $("[data-title]").textContent = k.title;
      $("[data-artist]").textContent = k.artist;
      $("[data-duration]").textContent = fmt(k.duration);
      $("[data-index]").textContent = String(i + 1);
      cover.classList.add("swap");
      Object.assign(new Image(), { srcset: k.srcset, src: k.src }).decode().catch(() => {}).finally(() => {
        Object.assign(cover, { srcset: k.srcset, src: k.src, alt: k.album });
        cover.classList.remove("swap");
      });
      el.classList.add("jump"); // the bar snaps back to zero instead of easing backwards
      render();
      requestAnimationFrame(() => el.classList.remove("jump"));
    };
    const set = (playing: boolean) => {
      el.classList.toggle("paused", !playing);
      toggle.ariaLabel = playing ? el.dataset.labelPause! : el.dataset.labelPlay!;
      clearInterval(timer);
      if (playing) timer = window.setInterval(() => (++t >= tracks[i].duration ? load(i + 1) : render()), 1000);
    };

    render();
    set(!matchMedia("(prefers-reduced-motion: reduce)").matches);
    toggle.addEventListener("click", () => set(el.classList.contains("paused")));
    $("[data-next]").addEventListener("click", () => load(i + 1));
  });
</script>

<style>
  @layer components {
    .np { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-2); width: min(100%, 24rem); }
    .covers { position: relative; width: 3.5rem; height: 3.5rem; background: #000; }
    .cover { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity var(--dur-3) var(--ease-out); }
    .cover.swap { opacity: 0; }
    .meta { min-width: 0; }
    .kicker { display: flex; align-items: center; gap: .6em; color: var(--color-text-muted); }
    .count { margin-left: auto; font-variant-numeric: tabular-nums; }
    .track { color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: .1rem; }
    .title { color: var(--color-text-strong); }
    .bar { position: relative; height: 2px; background: var(--color-rule); margin-top: .45rem; }
    .fill { position: absolute; inset: 0; background: var(--color-accent); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform 1s linear; }
    .jump .fill { transition: none; }
    .time { display: flex; justify-content: space-between; color: var(--color-text-muted); margin-top: .2rem; font-variant-numeric: tabular-nums; }

    .eq { display: inline-flex; align-items: flex-end; gap: 2px; height: .8em; }
    .eq i { width: 2px; height: 100%; background: var(--color-accent); transform-origin: bottom; animation: eq 1.1s ease-in-out infinite alternate; }
    .eq i:nth-child(2) { animation-duration: .8s; animation-delay: -.3s; }
    .eq i:nth-child(3) { animation-duration: 1.4s; animation-delay: -.6s; }
    @keyframes eq { from { transform: scaleY(.25); } to { transform: scaleY(1); } }
    .paused .eq i { animation-play-state: paused; }

    .controls { display: flex; gap: .25rem; }
    .btn { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border: var(--border); color: var(--color-text); transition: border-color var(--dur-2); }
    .btn:hover { border-color: var(--color-accent); }
    .btn svg { width: .7rem; height: .7rem; fill: currentColor; }
    /* pause glyph while playing, play triangle while paused */
    .i-play, .paused .i-pause { display: none; }
    .paused .i-play { display: block; }
    @media (max-width: 480px) { .bias { display: none; } }
  }
  @media (prefers-reduced-motion: reduce) { .eq i { animation: none; transform: scaleY(.6); } .fill, .cover { transition: none; } }
</style>
