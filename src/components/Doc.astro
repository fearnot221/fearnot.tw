---
// The Resume as a real document: one A4 sheet, identical on screen and on paper.
// Chinese only; both names are shown. It deliberately drops the website's language (mono labels, motion, accent colour) for résumé conventions.
import Base from "../layouts/Base.astro";
import { person, experience, education, skills, awards, certifications, projects, type Role, type T } from "../data/profile";
import { ui, pathFor } from "../i18n";
import { docLd } from "../seo";

const lang = "zh";
const onResume = <X extends { resume?: boolean }>(xs: X[]) => xs.filter((x) => x.resume);
const name = person.name.zh;
const path = "/resume/";
const pdf = `/pdf/resume-${lang}.pdf`;
const fileName = `${name.replace(/\s+/g, "-")}-Resume.pdf`;
const range = (e: Role) => (e.end === e.start ? e.start : `${e.start} – ${e.end ?? ui.present[lang]}`);
const bullets = (e: Role): T[] => [...(e.summary ? [e.summary] : []), ...(e.details ?? [])];
const contact = [
  { text: person.email, href: `mailto:${person.email}` },
  ...person.links.map((l) => ({ text: l.text, href: l.href })),
  { text: "fearnot.tw", href: "https://fearnot.tw" },
];
---
<Base theme="paper" title={`Resume — ${name}`} description={`${name} ${person.name.en} (Fearnot) — Resume. ${person.summary[lang]}`} lang={lang} path={path} monolingual ogImage={`/og/resume-${lang}.png`} jsonld={docLd(lang, new URL(pathFor(lang, path), Astro.site).href)}>
  <header class="toolbar top mono">
    <a class="home" href={pathFor(lang, "/")}>← fearnot.tw</a>
    <div class="actions">
      <button type="button" class="doc" data-print>{ui.print[lang]}</button>
      <a class="doc" href={pdf} download={fileName}><span class="wide">{ui.download[lang]} </span>PDF</a>
    </div>
  </header>

  <main id="main" class="sheet">
    <header class="r-head">
      <div>
        <h1>{name}<span class="r-en" lang="en">{person.name.en}</span></h1>
        <p class="r-sub">Fearnot · {person.roles[lang]}</p>
      </div>
      <ul class="r-contact">
        {contact.map((c) => <li><a href={c.href}>{c.text}</a></li>)}
        <li>{person.location[lang]}</li>
      </ul>
    </header>

    <section aria-labelledby="summary">
      <h2 id="summary">{ui.summary[lang]}</h2>
      <p>{person.summary[lang]}</p>
    </section>
    <section aria-labelledby="skills">
      <h2 id="skills">{ui.skills[lang]}</h2>
      <dl class="r-skills">
        {skills.map((k) => <><dt>{k.group}</dt><dd>{k.items[lang]}</dd></>)}
      </dl>
    </section>

    <section aria-labelledby="education">
      <h2 id="education">{ui.education[lang]}</h2>
      {onResume(education).map((e) => (
        <div class="r-row"><strong>{e.title[lang]}</strong><span class="r-date">{range(e)}</span></div>
      ))}
    </section>

    <section aria-labelledby="experience">
      <h2 id="experience">{ui.experience[lang]}</h2>
      {onResume(experience).map((o) => (
        <article class="r-entry">
          {o.roles.map((e) => (
            <Fragment>
              <div class="r-row"><h3><strong>{e.title[lang]}</strong><span class="r-org">{o.org[lang]}</span></h3><span class="r-date">{range(e)}</span></div>
              <ul class="r-bullets">{bullets(e).map((b) => <li>{b[lang]}</li>)}</ul>
            </Fragment>
          ))}
          {o.summary && <ul class="r-bullets"><li>{o.summary[lang]}</li></ul>}
        </article>
      ))}
    </section>

    <section aria-labelledby="awards">
      <h2 id="awards">{ui.awardsCerts[lang]}</h2>
      {[...onResume(awards), ...onResume(certifications)].map((a) => (
        <div class="r-row"><span>{a.title[lang]}</span><span class="r-date">{a.year}</span></div>
      ))}
    </section>

    <section aria-labelledby="projects">
      <h2 id="projects">{ui.projects[lang]}</h2>
      {onResume(projects).map((p) => (
        <div class="r-row"><span><strong>{p.href ? <a href={p.href}>{p.title[lang]}</a> : p.title[lang]}</strong>{p.summary && <span class="r-desc">{p.summary[lang]}</span>}</span><span class="r-date">{p.start}</span></div>
      ))}
    </section>

  </main>
</Base>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

<style>
  @layer components {
    :global(body) { background: #e8e7e3; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); max-width: calc(210mm + 2 * var(--gutter)); margin-inline: auto; padding: var(--space-3) var(--gutter); }
    .toolbar .home { text-decoration: none; white-space: nowrap; }
    .toolbar .doc { background: #fff; }

    /* ── the sheet: sizes in pt/mm so screen and print are the same object ── */
    .sheet {
      --ink: #161616; --soft: #5a5a5a; --hair: #c9c9c5;
      width: 210mm; min-height: 297mm; margin: 0 auto var(--space-5); padding: 15mm 17mm;
      background: #fff; color: var(--ink); border: 1px solid #d6d5d0;
      font: 400 9.5pt / 1.5 var(--font-serif); letter-spacing: 0;
    }
    .sheet a { color: inherit; text-decoration: none; }
    .sheet a:hover { text-decoration: underline; }
    /* on screen the contact links get a full 24px hit area (WCAG 2.5.8); paper keeps the tight column */
    @media screen { .r-contact a { display: inline-block; min-height: 24px; line-height: 24px; } .r-contact { line-height: 24px; } }

    .r-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12pt; padding-bottom: 8pt; border-bottom: 1.2pt solid var(--ink); }
    .r-head h1 { font: 600 22pt / 1.1 var(--font-serif); letter-spacing: .06em; }
    .r-en { margin-left: .5em; font-size: 13pt; font-weight: 400; letter-spacing: .02em; color: var(--soft); }
    .r-sub { color: var(--soft); margin-top: 3pt; }
    .r-contact { text-align: right; font-size: 8.5pt; line-height: 1.55; color: var(--soft); }

    .sheet section { margin-top: 11pt; }
    .sheet h2 { font: 600 9.5pt / 1.3 var(--font-serif); letter-spacing: .18em; padding-bottom: 2.5pt; margin-bottom: 5pt; border-bottom: .6pt solid var(--hair); }
    :global(:root:lang(en)) .sheet h2 { text-transform: uppercase; letter-spacing: .12em; font-size: 8.5pt; }

    .r-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; }
    .r-row + .r-row { margin-top: 2.5pt; }
    .r-row h3 { font: inherit; }
    .r-date { flex: none; color: var(--soft); font-size: 8.5pt; font-variant-numeric: tabular-nums lining-nums; }
    strong { font-weight: 600; }
    .r-org { color: var(--soft); margin-left: .6em; }
    .r-desc { color: var(--soft); }
    .r-desc::before { content: " — "; }
    :global(:root:not(:lang(en))) .r-desc::before { content: "："; }

    .r-entry + .r-entry { margin-top: 6pt; }
    .r-entry { break-inside: avoid; }
    .r-bullets { list-style: disc; padding-left: 1.15em; margin-top: 1.5pt; }
    .r-bullets + .r-row { margin-top: 3pt; }
    .r-bullets li { padding-left: .15em; text-wrap: pretty; }
    .r-bullets li::marker { color: #9a9a96; }

    .r-skills { display: grid; grid-template-columns: 6.5em 1fr; gap: 1.5pt 10pt; }
    .r-skills dt { font-weight: 600; }

    /* phones: the sheet becomes the page, in readable px instead of pt */
    @media screen and (max-width: 820px) {
      :global(body) { background: #fff; }
      .toolbar .doc { background: none; }
      .sheet { width: auto; min-height: 0; margin: 0; padding: var(--space-2) var(--gutter) var(--space-5); border: 0; font-size: 15px; }
      .r-head { flex-direction: column; align-items: flex-start; }
      .r-contact { text-align: left; font-size: 13px; }
      .r-head h1 { font-size: 28px; }
      .r-en { font-size: 18px; }
      .r-date, .sheet h2 { font-size: 13px; }
      .r-row { flex-direction: column; gap: 0; }
      .r-date { order: -1; }
      .r-row + .r-row { margin-top: 8px; }
    }
  }

  @media print {
    @page { size: A4; margin: 0; }
    @layer components {
      :global(body) { background: #fff; }
      .toolbar { display: none; }
      .sheet { margin: 0; border: 0; min-height: 0; width: auto; }
    }
  }
</style>
