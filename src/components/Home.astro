---
import Base from "../layouts/Base.astro";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getImage } from "astro:assets";
import { person, experience, communities, awards, certifications, projects, footerGifs, reservedGifSlots, type Lang, type Org, type Role } from "../data/profile";
import { ui, pathFor } from "../i18n";
import { homeLd } from "../seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const onResume = <X extends { resume?: boolean }>(xs: X[]) => xs.filter((x) => x.resume);
const honors = [...onResume(awards), ...onResume(certifications)];
const range = (r: Pick<Role, "start" | "end">) => (r.start === r.end ? r.start : `${r.start} — ${r.end ?? ui.present[lang]}`);
// the community's years run from its first role's start to its last role's end (an open role keeps it open)
const span = (o: Org) => range({
  start: o.roles.map((r) => r.start).sort()[0],
  end: o.roles.some((r) => !r.end) ? undefined : o.roles.map((r) => r.end!).sort().at(-1),
});
// fetched from Gravatar at build time and served from this site as a small webp
// Astro fetches remote images late in the build and fails it on a 404, so check first:
// an unreachable or missing Gravatar falls back to the empty frame instead of breaking the deploy
const reachable = person.avatar && (await fetch(person.avatar, { method: "HEAD" }).then((r) => r.ok, () => false));
const avatar = reachable ? await getImage({ src: person.avatar!, width: 144, height: 144, densities: [1, 2], format: "webp", quality: 80 }) : undefined;
const links = [{ label: person.email, href: `mailto:${person.email}`, icon: "mail" }, ...person.links.map((l) => ({ label: l.label, href: l.href, icon: l.label }))];
// inline paths (Lucide, ISC; GitHub's Octicon mark), so the icons cost no request; unknown labels get the globe
const icons: Record<string, { box: string; fill?: boolean; d: string[] }> = {
  mail: { box: "0 0 24 24", d: ["M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z", "m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"] },
  GitHub: { box: "0 0 16 16", fill: true, d: ["M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"] },
  globe: { box: "0 0 24 24", d: ["M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0z", "M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20", "M2 12h20"] },
};
---
<Base title={`Fearnot — ${person.roles[lang]}`} description={person.lede[lang]} lang={lang} path="/" ogImage={`/og/home-${lang}.png`} jsonld={homeLd(lang)}>
  <link slot="head" rel="preload" href="/fonts/literata-display.woff2" as="font" type="font/woff2" crossorigin />
  {lang === "zh" && <link slot="head" rel="preload" href="/fonts/noto-serif-tc-400.woff2" as="font" type="font/woff2" crossorigin />}
  <div class="page">
    <header class="top mono">
      <a class="home" href={pathFor(lang, "/")} aria-current="page"><span class="status link-up" aria-hidden="true" data-port></span>fearnot.tw</a>
      <div class="actions enter" style="--i: 2">
        <div class="prefs"><LangSwitch lang={lang} path="/" /><ThemeToggle lang={lang} /></div>
        <nav class="docs" aria-label={ui.docs[lang]}>
          <a class="doc" href="/resume/" hreflang="zh-Hant-TW">Resume</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="hero">
        <div class="id">
          <div>
            <h1 class="name"><span class="word">Fearnot</span><span class="cursor" aria-hidden="true" data-cursor></span></h1>
            <p class="roles mono muted enter" style="--i: 8">{person.roles[lang]}</p>
            <ul class="links mono enter" style="--i: 9">
              {links.map((l) => {
                const i = icons[l.icon] ?? icons.globe;
                return (
                  <li>
                    <a href={l.href} rel={l.href.startsWith("mailto:") ? undefined : "me"} aria-label={l.label} title={l.label}>
                      <svg viewBox={i.box} aria-hidden="true" fill={i.fill ? "currentColor" : "none"} stroke={i.fill ? "none" : "currentColor"} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">{i.d.map((d) => <path d={d} />)}</svg>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
          <figure class="avatar enter" style="--i: 6">
            {avatar ? <img src={avatar.src} srcset={avatar.srcSet.attribute} alt="Fearnot" width="144" height="144" loading="lazy" decoding="async" /> : <span class="frame" aria-hidden="true"></span>}
          </figure>
        </div>
        <p class="lede">{person.lede[lang]}</p>
      </div>

      <section class="section" aria-labelledby="experience">
        <h2 class="label" id="experience">{ui.experience[lang]}</h2>
        <ol class="entries reveal">
          {onResume(experience).map((o) => (
            <li>
              <span class="when mono">{span(o)}</span>
              <span class="org">{o.org[lang]}</span>
              {o.roles.map((r) => (
                <div class="role">
                  {/* a role's own years only when they differ from the community's */}
                  <h3>{r.title[lang]}{range(r) !== span(o) && <span class="role-when mono">{range(r)}</span>}</h3>
                  {r.summary && <p>{r.summary[lang]}</p>}
                </div>
              ))}
              {o.summary && <p class="shared">{o.summary[lang]}</p>}
            </li>
          ))}
        </ol>
      </section>

      <section class="section" aria-labelledby="communities">
        <h2 class="label" id="communities">{ui.communities[lang]}</h2>
        <ul class="list projects reveal">
          {communities.map((c) => (
            <li><span>{c.href ? <a href={c.href}>{c.name[lang]}</a> : c.name[lang]}{c.summary && <small>{c.summary[lang]}</small>}</span></li>
          ))}
        </ul>
      </section>

      <section class="section" aria-labelledby="honors">
        <h2 class="label" id="honors">{ui.awardsCerts[lang]}</h2>
        <ul class="list reveal">
          {honors.map((h) => <li><span>{h.title[lang]}</span><span class="mono muted">{h.year}</span></li>)}
        </ul>
      </section>

      <section class="section" aria-labelledby="projects">
        <h2 class="label" id="projects">{ui.projects[lang]}</h2>
        <ul class="list projects reveal">
          {projects.map((p) => (
            <li>
              <span><a href={p.href}>{p.title[lang]}</a>{p.summary && <small>{p.summary[lang]}</small>}</span>
              <span class="mono muted">{p.start}</span>
            </li>
          ))}
        </ul>
      </section>

    </main>

    <footer class="foot mono muted">
      <span class="copy">© 2026 Fearnot</span>
      <ul class="gifs" aria-label="Winter">
        {footerGifs.length
          ? footerGifs.map((src) => <li><img src={src} alt="" width="96" height="96" decoding="async" loading="lazy" /></li>)
          : Array.from({ length: reservedGifSlots }, () => <li class="frame" aria-hidden="true"></li>)}
      </ul>
    </footer>
  </div>
</Base>

<script>
  // Last beat of the intro: the cursor that revealed the name flies up into the header and becomes its status light.
  // CSS alone already plays blink → sweep → fade, so without JS (or with reduced motion) nothing is lost.
  const cursor = document.querySelector<HTMLElement>("[data-cursor]");
  const port = document.querySelector<HTMLElement>("[data-port]");
  if (cursor && port && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    port.style.animation = "none";
    port.style.opacity = "0";
    cursor.addEventListener("animationend", (e) => {
      if (e.animationName !== "sweep") return;
      const from = cursor.getBoundingClientRect(), to = port.getBoundingClientRect();
      if (to.bottom < 0) { port.style.opacity = ""; return; } // scrolled away: skip the flight
      cursor.style.left = getComputedStyle(cursor).left; // keep the sweep's end point once its animation is dropped
      cursor.style.animation = "none";
      cursor.style.transformOrigin = "0 0"; // translate is measured from the top-left corner, so scale from there too
      const flight = cursor.animate(
        [
          { transform: "none" },
          { transform: `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(${to.width / from.width})` },
        ],
        { duration: 650, easing: "cubic-bezier(.65, 0, .35, 1)", fill: "forwards" },
      );
      flight.finished.then(() => {
        cursor.remove();
        port.style.opacity = "";
        port.animate([{ opacity: 1 }, { opacity: 0.2 }, { opacity: 1 }], { duration: 260, easing: "steps(2, jump-none)" });
      });
    });
  }
</script>

<style>
  @layer components {
    .hero { --intro-delay: 420ms; padding-block: clamp(3.5rem, 1.5rem + 7vw, 8rem) var(--section); }

    /* ── intro: a cursor blinks, then scans the name into existence ── */
    .name { position: relative; display: inline-block; font: 600 var(--step-4) / var(--leading-display) var(--font-display); letter-spacing: var(--tracking-display); }
    .word { display: inline-block; clip-path: inset(-.2em 100% -.2em 0); animation: reveal var(--dur-5) var(--ease-in-out) var(--intro-delay) forwards; }
    .cursor {
      position: absolute; left: 0; bottom: .12em; width: .13em; height: .13em; background: var(--color-accent);
      animation: blink var(--intro-delay) steps(1, end) both, sweep var(--dur-5) var(--ease-in-out) var(--intro-delay) both, gone var(--dur-2) ease-out calc(var(--intro-delay) + var(--dur-5) + 400ms) forwards;
    }
    @keyframes reveal { to { clip-path: inset(-.2em 0 -.2em 0); } }
    @keyframes blink { 0%, 50% { opacity: 1; } 25%, 75% { opacity: 0; } }
    @keyframes sweep { from { left: 0; } to { left: calc(100% + .08em); } }
    @keyframes gone { to { opacity: 0; } }

    .id { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: var(--space-3); }
    .avatar { position: relative; width: clamp(5rem, 3rem + 6vw, 8.5rem); aspect-ratio: 1; margin-bottom: .35rem; }
    .avatar img, .avatar .frame { display: block; width: 100%; height: 100%; object-fit: cover; }
    .avatar img { background: var(--color-surface); }
    .avatar .frame { border: var(--border); }
    /* the brand square sits on the corner, photo or not */
    .avatar::after { content: ""; position: absolute; right: -1px; bottom: -1px; width: .5rem; height: .5rem; background: var(--color-accent); }
    @media (max-width: 560px) { .id { grid-template-columns: 1fr; } .avatar { order: -1; width: 4.5rem; margin-bottom: var(--space-2); } }

    .roles { margin-top: var(--space-2); }
    .links { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); margin-left: -.6rem; }
    /* 44px hit area around a 20px glyph; the negative margin lines the first glyph up with the name */
    .links a { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; color: var(--color-text-muted); transition: color var(--dur-2) var(--ease-out); }
    .links a:hover, .links a:focus-visible { color: var(--color-accent); }
    .links svg { width: 1.25rem; height: 1.25rem; }

    /* the lede is the largest text on screen: it paints at once, never behind an animation */
    .lede { font-size: var(--step-2); line-height: 1.65; max-width: 30em; margin-top: var(--space-4); text-wrap: pretty; }
    :global(:root:lang(en)) .lede { line-height: 1.5; }

    .entries h3 a { text-decoration-color: var(--color-rule); }
    .role + .role, .shared { margin-top: var(--space-2); }
    .role-when { font-size: var(--step--1); font-weight: 400; color: var(--color-text-muted); margin-left: .6em; }
    .projects a { text-decoration-color: var(--color-rule); }
    .projects small { display: block; font-size: var(--step--1); line-height: 1.6; color: var(--color-text-muted); margin-top: .15rem; }
    .list li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); padding-block: var(--space-2); }
    .list li + li { border-top: var(--border); }
    .list li:first-child { padding-top: 0; }

    /* GIF strip on the right of the sign-off; any number of squares, wrapping from the right */
    .gifs { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-1); margin-left: auto; }
    .gifs li { width: 3.5rem; aspect-ratio: 1; }
    .gifs img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .gifs .frame { border: var(--border); }
    .gifs .frame:last-child { position: relative; }
    .gifs .frame:last-child::after { content: ""; position: absolute; right: -1px; bottom: -1px; width: .35rem; height: .35rem; background: var(--color-accent); }
    .copy { align-self: flex-end; }
    .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--section); padding-top: var(--space-3); border-top: var(--border); }
  }
  @media (prefers-reduced-motion: reduce) {
    .word { clip-path: none; animation: none; }
    .cursor { display: none; }
  }
</style>
